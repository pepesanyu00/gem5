# Makefile for the ARM SVE "vector lanes" chime-timing microbenchmark
# (bench_sve_lanes.S). See that file's header comment for background.
#
# Usage
# -----
#
# Build the default matrix of benchmark variants into build_sve/:
#
#   make -f Makefile_sve
#
# Build a single, custom-parametrized variant:
#
#   make -f Makefile_sve custom ELEM_WIDTH=64 CHAIN=1 NITER=5000 UNROLL=16 \
#       OUT=build_sve/custom_elem64_chain
#
# Cross-compiler
# --------------
# Override CROSS_COMPILE if your toolchain uses a different prefix, e.g.:
#
#   make -f Makefile_sve CROSS_COMPILE=aarch64-none-elf-
#
# The toolchain must support SVE (gcc >= 10, binutils >= 2.28, or equivalent
# with SVE support via -march=armv8.2-a+sve).

CROSS_COMPILE ?= aarch64-linux-gnu-
CC             = $(CROSS_COMPILE)gcc
ARCH           = armv8.2-a+sve
CFLAGS         = -march=$(ARCH) -nostdlib -static -Wl,-e,_start
BUILD          = build_sve

# Element widths for the default `all` target.
ELEM_WIDTHS = 8 32 64
NITER       ?= 2000
UNROLL      ?= 32

SRC = bench_sve_lanes.S

.PHONY: all clean custom

all: $(BUILD)
	@for ew in $(ELEM_WIDTHS); do \
	  for mode in indep chain; do \
	    name=$(BUILD)/bench_sve_elem$${ew}_$${mode}; \
	    if [ "$$mode" = "chain" ]; then chain_flag="-DCHAIN"; else chain_flag=""; fi; \
	    echo "Building $$name (ELEM_WIDTH=$$ew mode=$$mode)"; \
	    $(CC) $(CFLAGS) -DELEM_WIDTH=$$ew -DNITER=$(NITER) \
	      -DUNROLL=$(UNROLL) $$chain_flag -o $$name $(SRC); \
	  done; \
	done
	@echo "Binaries written to $(BUILD)/"

# Single custom build, e.g.:
#   make -f Makefile_sve custom ELEM_WIDTH=32 CHAIN=1 OUT=build_sve/my_bench
ELEM_WIDTH ?= 32
OUT        ?= $(BUILD)/bench_sve_custom
DEFS        = -DELEM_WIDTH=$(ELEM_WIDTH) -DNITER=$(NITER) -DUNROLL=$(UNROLL)
ifdef CHAIN
DEFS       += -DCHAIN
endif

custom: $(BUILD)
	$(CC) $(CFLAGS) $(DEFS) -o $(OUT) $(SRC)
	@echo "Built $(OUT) (ELEM_WIDTH=$(ELEM_WIDTH) CHAIN=$(CHAIN))"

$(BUILD):
	mkdir -p $(BUILD)

clean:
	rm -rf $(BUILD)
